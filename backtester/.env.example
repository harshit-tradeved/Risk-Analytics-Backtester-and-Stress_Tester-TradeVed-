# ── TradingView (optional — used for data scraping) ──────────────────────────
TV_USERNAME=your_tradingview_email@example.com
TV_PASSWORD=your_tradingview_password
# If you use Google OAuth for TradingView, paste the sessionid cookie here instead
TV_SESSIONID=your_tradingview_sessionid_cookie

# ── Fyers API (optional — 9 years of NSE/BSE intraday OHLCV data, free tier) ─
# Register at https://myapi.fyers.in to get these credentials
FYERS_CLIENT_ID=XXXXXXXXXX-200
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_REDIRECT_URI=https://fyers.in
# Access token expires daily — regenerate by running: python fyers_auth.py
FYERS_ACCESS_TOKEN=your_fyers_access_token_here
